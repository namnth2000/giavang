{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "giavang",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "PRICES",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
